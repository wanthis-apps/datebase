# Expo は EXPO_PUBLIC_ で始まる値だけを JS バンドルへ埋め込みます。
# このファイルをコピーして .env を作り、実際の値を入れてください。
#   copy .env.example .env
# サービスロールキーは絶対に入れないでください。
# 変更後は npx expo start --clear で再起動してください。

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ネイティブの地図設定だけに使い、JS バンドルには埋め込みません。
# EAS の本番ビルドでは、同じ名前の環境変数を Expo に登録してください。
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
